<Window x:Class="Ferah.App.ReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşlemi gözden geçir" Icon="Assets/Ferah.ico" Width="760" Height="650" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}">
  <Grid Margin="26" Background="{StaticResource Background}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="47" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Width="39" Height="39" CornerRadius="12" Background="#2A3D3A" VerticalAlignment="Top">
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Warning}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="14" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#2A251D" BorderBrush="#5B4B33" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,20,0,14">
      <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" LineHeight="20" />
    </Border>
    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Background="#141C28">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
          <TextBlock Text="ÖĞE VE KONUM" Style="{StaticResource SectionLabel}" Margin="14,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="BOYUT" Style="{StaticResource SectionLabel}" Margin="14,0" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="{StaticResource Card}" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Text}" /></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="14,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Size}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <TextBlock Grid.Row="3" Text="{Binding TruncatedText}" Foreground="{StaticResource Warning}" FontSize="11" Margin="2,8,0,0" Visibility="{Binding IsTruncated, Converter={StaticResource BoolVisible}}" />
    <Grid Grid.Row="4" Margin="0,18,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <CheckBox IsChecked="{Binding Acknowledged}" Content="{Binding Acknowledgement}" AutomationProperties.Name="İşlem onayı" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Content="Vazgeç" IsCancel="True" MinWidth="100" Margin="0,0,10,0" />
        <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" IsDefault="True" MinWidth="175" IsEnabled="{Binding Acknowledged}" Click="ConfirmClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
