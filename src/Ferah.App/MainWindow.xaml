<Window x:Class="Ferah.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="Ferah · Disk ve sistem bakımı" Icon="Assets/Ferah.ico"
        Width="1420" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="244" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sol gezinme -->
    <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#222D3D" BorderThickness="0,0,1,0">
      <Grid Margin="18,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="30" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
          <Border Width="43" Height="43" CornerRadius="13" Background="#213E3C" BorderBrush="#397263" BorderThickness="1">
            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="12,1,0,0">
            <TextBlock Text="Ferah" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="DİSK VE SİSTEM BAKIMI" Style="{StaticResource SectionLabel}" FontSize="9" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <TextBlock Text="BAKIM" Style="{StaticResource SectionLabel}" Margin="14,0,0,8" />
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}"
                       CommandParameter="Overview" IsChecked="{Binding IsOverview, Mode=OneWay}" AutomationProperties.Name="Genel bakış">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="16" Width="29" /><TextBlock Text="Genel bakış" VerticalAlignment="Center" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}"
                       CommandParameter="Cleanup" IsChecked="{Binding IsCleanup, Mode=OneWay}" AutomationProperties.Name="Disk temizliği">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="16" Width="29" /><TextBlock Text="Disk temizliği" VerticalAlignment="Center" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}"
                       CommandParameter="Large" IsChecked="{Binding IsLarge, Mode=OneWay}" AutomationProperties.Name="Büyük dosyalar">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="16" Width="29" /><TextBlock Text="Büyük dosyalar" VerticalAlignment="Center" /></StackPanel>
          </RadioButton>
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}"
                       CommandParameter="Performance" IsChecked="{Binding IsPerformance, Mode=OneWay}" AutomationProperties.Name="Performans ayarları">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="16" Width="29" /><TextBlock Text="Performans" VerticalAlignment="Center" /></StackPanel>
          </RadioButton>
          <TextBlock Text="KAYITLAR" Style="{StaticResource SectionLabel}" Margin="14,25,0,8" />
          <RadioButton GroupName="Navigation" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}"
                       CommandParameter="History" IsChecked="{Binding IsHistory, Mode=OneWay}" AutomationProperties.Name="İşlem geçmişi">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="16" Width="29" /><TextBlock Text="İşlem geçmişi" VerticalAlignment="Center" /></StackPanel>
          </RadioButton>
        </StackPanel>

        <Border Grid.Row="4" Background="#151E2A" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="11" Padding="13">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="31" Height="31" CornerRadius="16" Background="#26354A">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Violet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{Binding UserMode}" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="Yerel · İnternetsiz" Style="{StaticResource MutedText}" FontSize="10" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Ana alan -->
    <Grid Grid.Column="1" Background="{StaticResource Background}">
      <Grid.RowDefinitions>
        <RowDefinition Height="96" />
        <RowDefinition Height="*" />
        <RowDefinition Height="43" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="#222D3D" BorderThickness="0,0,0,1" Background="#101722">
        <Grid Margin="34,18,34,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}">
              <TextBlock Text="İşlem sürüyor" Foreground="{StaticResource Accent}" FontWeight="SemiBold" HorizontalAlignment="Right" />
              <ProgressBar Width="150" Margin="0,7,0,0" IsIndeterminate="True" />
            </StackPanel>
            <Button Content="Durdur" Command="{Binding CancelCommand}" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisible}}"
                    AutomationProperties.HelpText="Devam eden tarama veya dosya işlemini güvenli noktada durdurur" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <!-- GENEL BAKIŞ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Background}"
                      Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=Overview}">
          <StackPanel Margin="34,28,34,36" MaxWidth="1260" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardBorder}" Padding="30" BorderBrush="#315D57">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Bilgisayarın ne durumda?" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="Önce güvenli alanları tara; Ferah hiçbir şeyi kendiliğinden silmez veya değiştirmez."
                             Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0" MaxWidth="680" />
                  <TextBlock Text="{Binding ComputerText}" Foreground="{StaticResource Accent}" Margin="0,17,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Temizliği tara" Command="{Binding ScanCleanupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                          AutomationProperties.HelpText="Geçici dosyaları bulur, silmez" />
                  <Button Content="Büyük dosyaları bul" Command="{Binding NavigateCommand}" CommandParameter="Large" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock Text="ANLIK DURUM" Style="{StaticResource SectionLabel}" Margin="2,27,0,10" />
            <UniformGrid Columns="3">
              <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                <StackPanel>
                  <Grid><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" /><TextBlock Text="Disk" Margin="31,0,0,0" FontWeight="SemiBold" /><TextBlock Text="{Binding DiskFree}" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" /></Grid>
                  <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource MutedText}" Margin="0,11,0,10" />
                  <ProgressBar Value="{Binding DiskUsedPercent, Mode=OneWay}" Maximum="100" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="4,0">
                <StackPanel>
                  <Grid><TextBlock Text="&#xE950;" Style="{StaticResource Icon}" Foreground="{StaticResource Violet}" /><TextBlock Text="Bellek" Margin="31,0,0,0" FontWeight="SemiBold" /><TextBlock Text="{Binding MemoryPercent}" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" /></Grid>
                  <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource MutedText}" Margin="0,11,0,10" />
                  <ProgressBar Value="{Binding MemoryUsedPercent, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Violet}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                <StackPanel>
                  <Grid><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}" /><TextBlock Text="İşlemci" Margin="31,0,0,0" FontWeight="SemiBold" /><TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontSize="21" FontWeight="SemiBold" /></Grid>
                  <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource MutedText}" Margin="0,11,0,10" />
                  <ProgressBar Value="{Binding CpuPercent, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Warning}" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <TextBlock Text="SÜRÜCÜLER" Style="{StaticResource SectionLabel}" Margin="2,27,0,10" />
            <ItemsControl ItemsSource="{Binding DriveCards}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,12,12" Padding="18">
                    <StackPanel>
                      <Grid><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="17" /><TextBlock Text="{Binding Name}" Margin="28,0,0,0" FontWeight="SemiBold" /></Grid>
                      <TextBlock Text="{Binding Free}" Style="{StaticResource MutedText}" Margin="0,9,0,9" />
                      <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="HIZLI ARAÇLAR" Style="{StaticResource SectionLabel}" Margin="2,16,0,10" />
            <UniformGrid Columns="4">
              <Button Command="{Binding OpenToolCommand}" CommandParameter="Storage" Margin="0,0,8,0" ToolTip="Windows Depolama ayarlarını açar">
                <StackPanel><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Depolama ayarları" Margin="0,8,0,0" /></StackPanel>
              </Button>
              <Button Command="{Binding OpenToolCommand}" CommandParameter="Startup" Margin="3,0,5,0" ToolTip="Windows Başlangıç uygulamaları sayfasını açar">
                <StackPanel><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Başlangıç uygulamaları" Margin="0,8,0,0" /></StackPanel>
              </Button>
              <Button Command="{Binding OpenToolCommand}" CommandParameter="TaskManager" Margin="5,0,3,0" ToolTip="Windows Görev Yöneticisi'ni açar">
                <StackPanel><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Görev Yöneticisi" Margin="0,8,0,0" /></StackPanel>
              </Button>
              <Button Command="{Binding OpenToolCommand}" CommandParameter="RecycleBin" Margin="8,0,0,0" ToolTip="Geri Dönüşüm Kutusu'nu açar">
                <StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Geri Dönüşüm Kutusu" Margin="0,8,0,0" /></StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>

        <!-- TEMİZLİK -->
        <Grid Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=Cleanup}" Margin="34,26,34,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorder}" Padding="22" BorderBrush="#315D57">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding CleanupHeadline}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CleanupDetail}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Güvenli önerileri seç" Command="{Binding SelectSafeCleanupCommand}" Margin="0,0,10,0" />
                <Button Content="Yeniden tara" Command="{Binding ScanCleanupCommand}" Style="{StaticResource PrimaryButton}" />
              </StackPanel>
            </Grid>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,16">
            <ItemsControl ItemsSource="{Binding CleanupItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="1,4,0,0" AutomationProperties.Name="{Binding Title}" />
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="17" Margin="0,0,9,0" />
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                          <Border Background="#283849" CornerRadius="8" Padding="8,3" Margin="10,-2,0,0">
                            <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Muted}" FontSize="10" />
                          </Border>
                          <Border Background="#2B3A36" CornerRadius="8" Padding="8,3" Margin="6,-2,0,0">
                            <TextBlock Text="{Binding Age}" Foreground="{StaticResource Accent}" FontSize="10" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,24,0" />
                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Warning}" FontSize="11" Margin="0,5,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolVisible}}" />
                        <TextBlock Text="Kapsamı görmek için üzerine gelin" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,0" ToolTip="{Binding Roots}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Size}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="18" Background="#141E2B">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding SelectedCleanupText}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Silmeden önce dosya listesi ve kalıcı silme uyarısı gösterilir." Style="{StaticResource MutedText}" FontSize="11" />
              </StackPanel>
              <Button Grid.Column="1" Content="Seçimi gözden geçir" Command="{Binding CleanCommand}" Style="{StaticResource DangerButton}" />
            </Grid>
          </Border>
        </Grid>

        <!-- BÜYÜK DOSYALAR -->
        <Grid Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=Large}" Margin="34,24,34,24">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorder}" Padding="18">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="170" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display" AutomationProperties.Name="Sürücü seçimi" />
              <TextBox Grid.Column="2" Text="{Binding ScanPath, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding ScanPath}" AutomationProperties.Name="Taranacak klasör" />
              <Button Grid.Column="4" Content="Klasör seç" Command="{Binding PickFolderCommand}" />
              <StackPanel Grid.Column="6" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding SizeOptions}" SelectedItem="{Binding MinimumSize}" DisplayMemberPath="Label" Margin="0,0,10,0" AutomationProperties.Name="En küçük dosya boyutu" />
                <Button Content="Tara" Command="{Binding ScanLargeCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <TextBlock><Run Text="İncelenen: " Foreground="{StaticResource Muted}" /><Run Text="{Binding ExaminedFilesText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock Grid.Column="1"><Run Text="Mantıksal boyut: " Foreground="{StaticResource Muted}" /><Run Text="{Binding ExaminedBytesText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock Grid.Column="2"><Run Text="Atlanan: " Foreground="{StaticResource Muted}" /><Run Text="{Binding SkippedText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
            <TextBlock Grid.Column="3" Text="{Binding LargeDetail}" Style="{StaticResource MutedText}" TextAlignment="Right" />
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <Grid>
              <DataGrid ItemsSource="{Binding LargeFilesView}" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="52" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanRecycle}" ToolTip="{Binding BlockReason}" AutomationProperties.Name="{Binding Name}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="DOSYA" Width="2.4*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /></StackPanel></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="TÜR" Binding="{Binding Kind}" Width="120" SortMemberPath="Kind" />
                  <DataGridTextColumn Header="BOYUT" Binding="{Binding Size}" Width="120" SortMemberPath="Bytes" />
                  <DataGridTemplateColumn Header="DURUM" Width="130" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" /><TextBlock Text="{Binding BlockReason}" Style="{StaticResource MutedText}" FontSize="9" TextTrimming="CharacterEllipsis" ToolTip="{Binding BlockReason}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="&#xE838;" FontFamily="Segoe MDL2 Assets" Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource LinkButton}" ToolTip="Dosyayı Dosya Gezgini'nde göster" AutomationProperties.Name="Konumunu aç" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LargeEmpty, Converter={StaticResource BoolVisible}}">
                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="38" HorizontalAlignment="Center" />
                <TextBlock Text="Henüz sonuç yok" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Bir kapsam seçip Tara düğmesine basın." Style="{StaticResource MutedText}" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14" Margin="0,14,0,0" Background="#141E2B">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedLargeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text=" · Kalıcı silme yok" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" AutomationProperties.Name="Dosyalarda ara" ToolTip="Dosya adı veya tam yolda ara" />
              <Button Grid.Column="2" Content="CSV dışa aktar" Command="{Binding ExportLargeCommand}" Margin="0,0,10,0" />
              <Button Grid.Column="3" Content="Gözden geçir ve taşı" Command="{Binding RecycleCommand}" Style="{StaticResource PrimaryButton}" />
            </Grid>
          </Border>
        </Grid>

        <!-- PERFORMANS -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Background}"
                      Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=Performance}">
          <StackPanel Margin="34,25,34,36" MaxWidth="1260">
            <Border Style="{StaticResource CardBorder}" Background="#2A251D" BorderBrush="#5B4B33" Padding="18">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}" /><StackPanel Grid.Column="1"><TextBlock Text="Hız artışı garanti edilmez" FontWeight="SemiBold" Foreground="{StaticResource Warning}" /><TextBlock Text="Ferah; güvenlik yazılımlarını, Windows Update'i veya kritik servisleri kapatmaz. Aşağıdaki ayarlar görünüm, kayıt özellikleri ya da enerji tüketimini değiştirebilir. Her biri uygulanmadan önce yedeklenir." Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel></Grid>
            </Border>
            <Grid Margin="0,22,0,12">
              <TextBlock Text="SEÇİLEBİLİR AYARLAR" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Önerilenleri seç" Command="{Binding SelectRecommendedCommand}" Style="{StaticResource LinkButton}" /><Button Content="Durumu yenile" Command="{Binding RefreshSettingsCommand}" Margin="8,0,0,0" /></StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Tweaks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource CardBorder}" Padding="19" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanChange}" VerticalAlignment="Top" Margin="1,5,0,0" AutomationProperties.Name="{Binding Title}" />
                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="17" Margin="0,0,9,0" /><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" /><Border Background="#283849" CornerRadius="8" Padding="8,3" Margin="10,-2,0,0"><TextBlock Text="{Binding Badge}" Foreground="{StaticResource Muted}" FontSize="10" /></Border></StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,24,0" />
                        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" FontSize="11" Margin="0,5,24,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding State}" FontWeight="SemiBold" HorizontalAlignment="Right" /><TextBlock Text="Geri alınabilir" Foreground="{StaticResource Accent}" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0" /></StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0" Padding="18" BorderBrush="#315D57">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedTweakText}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Onay ekranından sonra önce eski değerler diske yazılır, ardından yalnızca seçili ayarlar uygulanır." Style="{StaticResource MutedText}" FontSize="11" /></StackPanel><Button Grid.Column="1" Content="Gözden geçir ve uygula" Command="{Binding ApplyTweaksCommand}" Style="{StaticResource PrimaryButton}" /></Grid>
            </Border>
            <TextBlock Text="GERİ ALMA" Style="{StaticResource SectionLabel}" Margin="2,27,0,10" />
            <Border Style="{StaticResource CardBorder}" Padding="18">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="Display" AutomationProperties.Name="Ayar yedeği" /><TextBlock Grid.Column="1" Text="{Binding BackupDetail}" Style="{StaticResource MutedText}" Margin="18,0" VerticalAlignment="Center" /><Button Grid.Column="2" Content="Önceki ayarlara dön" Command="{Binding RestoreCommand}" /></Grid>
            </Border>
            <TextBlock Text="WINDOWS ARAÇLARI" Style="{StaticResource SectionLabel}" Margin="2,27,0,10" />
            <UniformGrid Columns="4">
              <Button Command="{Binding OpenToolCommand}" CommandParameter="Optimize" Margin="0,0,7,0"><StackPanel><TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Sürücüleri iyileştir" Margin="0,7,0,0" /></StackPanel></Button>
              <Button Command="{Binding OpenToolCommand}" CommandParameter="DiskCleanup" Margin="3,0,4,0"><StackPanel><TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Windows Disk Temizleme" Margin="0,7,0,0" /></StackPanel></Button>
              <Button Command="{Binding OpenToolCommand}" CommandParameter="Startup" Margin="4,0,3,0"><StackPanel><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Başlangıç uygulamaları" Margin="0,7,0,0" /></StackPanel></Button>
              <Button Command="{Binding OpenToolCommand}" CommandParameter="Data" Margin="7,0,0,0"><StackPanel><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" HorizontalAlignment="Center" /><TextBlock Text="Yerel yedek klasörü" Margin="0,7,0,0" /></StackPanel></Button>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>

        <!-- GEÇMİŞ -->
        <Grid Visibility="{Binding Page, Converter={StaticResource PageVisible}, ConverterParameter=History}" Margin="34,25,34,28">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Border Style="{StaticResource CardBorder}" Padding="18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Yerel işlem günlüğü" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="En fazla son 100 işlem bu bilgisayarda tutulur. Dosya adları geçmişe kaydedilmez." Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Content="Yenile" Command="{Binding RefreshHistoryCommand}" Margin="0,0,10,0" /><Button Grid.Column="2" Content="CSV dışa aktar" Command="{Binding ExportHistoryCommand}" /></Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,16,0,0" ClipToBounds="True">
            <Grid>
              <DataGrid ItemsSource="{Binding History}" IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="TARİH" Binding="{Binding Date}" Width="165" />
                  <DataGridTextColumn Header="İŞLEM" Binding="{Binding Title}" Width="200" />
                  <DataGridTextColumn Header="AYRINTI" Binding="{Binding Detail}" Width="*" />
                  <DataGridTextColumn Header="SONUÇ" Binding="{Binding Status}" Width="110" />
                  <DataGridTextColumn Header="BOYUT" Binding="{Binding Size}" Width="115" />
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HistoryEmpty, Converter={StaticResource BoolVisible}}">
                <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="38" HorizontalAlignment="Center" />
                <TextBlock Text="Henüz işlem yok" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="Tamamlanan bakım işlemleri burada görünecek." Style="{StaticResource MutedText}" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="#101722" BorderBrush="#222D3D" BorderThickness="0,1,0,0">
        <Grid Margin="28,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
          <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
          <TextBlock Grid.Column="2" Text="Ferah 1.0 · Veriler cihazdan çıkmaz" Foreground="#687A92" VerticalAlignment="Center" FontSize="10" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
